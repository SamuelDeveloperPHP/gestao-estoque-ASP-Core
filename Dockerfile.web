FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props GestaoEstoque.sln ./
COPY src/ src/
COPY tests/ tests/
RUN dotnet restore GestaoEstoque.sln
RUN dotnet publish src/Web/GestaoEstoque.Web.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app .
# Pasta das chaves do Data Protection (monte um volume aqui para as sessões sobreviverem a reinícios).
RUN mkdir -p /keys && chown app:app /keys
USER app
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "GestaoEstoque.Web.dll"]
