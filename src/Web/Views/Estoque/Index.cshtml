@model EstoqueIndexViewModel
@{
    ViewData["Title"] = "Estoque";
}

@if (Model.Erro is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Erro</div>
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="produtoId" class="form-select" style="min-width:280px">
                <option value="">Todos os produtos</option>
                @foreach (var item in Model.Produtos)
                {
                    <option value="@item.Value" selected="@(Model.ProdutoId?.ToString() == item.Value)">@item.Text</option>
                }
            </select>
            <button type="submit" class="btn btn-soft-primary">Filtrar</button>
        </form>
        <a asp-action="Movimentar" class="btn btn-primary"><i class="ri-arrow-left-right-line align-bottom me-1"></i> Movimentar</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-nowrap align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>SKU</th>
                        <th>Produto</th>
                        <th>Depósito</th>
                        <th class="text-end">Quantidade</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Linhas.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Nenhum saldo registrado. Faça uma entrada para começar.</td></tr>
                }
                @foreach (var l in Model.Linhas)
                {
                    <tr>
                        <td class="fw-medium">@l.Sku</td>
                        <td>@l.Produto</td>
                        <td>@l.Deposito</td>
                        <td class="text-end fw-semibold">@l.Quantidade.ToString("0.####")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
