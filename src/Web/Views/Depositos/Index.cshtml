@model DepositosIndexViewModel
@{
    ViewData["Title"] = "Depósitos";
    var gestao = User.IsInRole("Gestor") || User.IsInRole("Administrador");
}

@if (Model.Erro is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Erro</div>
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title mb-0">Locais de armazenagem</h5>
        @if (gestao)
        {
            <a asp-action="Novo" class="btn btn-success"><i class="ri-add-line align-bottom me-1"></i> Novo depósito</a>
        }
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-nowrap align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Nome</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Itens.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Nenhum depósito cadastrado.</td></tr>
                }
                @foreach (var d in Model.Itens)
                {
                    <tr>
                        <td class="fw-medium">@d.Codigo</td>
                        <td>@d.Nome</td>
                        <td>
                            @if (d.Ativo) { <span class="badge bg-success-subtle text-success">Ativo</span> }
                            else { <span class="badge bg-secondary-subtle text-secondary">Inativo</span> }
                        </td>
                        <td class="text-end">
                            @if (gestao && d.Ativo)
                            {
                                <form asp-action="Desativar" asp-route-id="@d.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Desativar este depósito?');">
                                    <button type="submit" class="btn btn-sm btn-soft-danger">Desativar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
