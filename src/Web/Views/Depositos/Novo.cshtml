@model NovoDepositoViewModel
@{
    ViewData["Title"] = "Novo depósito";
}

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <partial name="_Erros" />
                <form asp-action="Novo" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label"></label>
                        <input asp-for="Codigo" class="form-control" maxlength="20" autofocus />
                        <div class="form-text">Até 20 caracteres: letras, números, "-" ou "_". Ex.: CD-SP</div>
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" maxlength="100" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-success">Salvar</button>
                    <a asp-action="Index" class="btn btn-light">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
