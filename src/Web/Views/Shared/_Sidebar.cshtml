@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Ativo(string nome) => string.Equals(controlador, nome, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<div class="app-menu navbar-menu">
    <div class="navbar-brand-box">
        <a asp-controller="Home" asp-action="Index" class="logo logo-dark">
            <span class="logo-sm"><img src="~/assets/images/logo-sm.png" alt="" height="22"></span>
            <span class="logo-lg"><img src="~/assets/images/logo-dark.png" alt="" height="17"></span>
        </a>
        <a asp-controller="Home" asp-action="Index" class="logo logo-light">
            <span class="logo-sm"><img src="~/assets/images/logo-sm.png" alt="" height="22"></span>
            <span class="logo-lg"><img src="~/assets/images/logo-light.png" alt="" height="17"></span>
        </a>
        <button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover" id="vertical-hover">
            <i class="ri-record-circle-line"></i>
        </button>
    </div>

    <div id="scrollbar">
        <div class="container-fluid">
            <div id="two-column-menu"></div>
            <ul class="navbar-nav" id="navbar-nav">
                <li class="menu-title"><span>Menu</span></li>
                <li class="nav-item">
                    <a class="nav-link menu-link @Ativo("Home")" asp-controller="Home" asp-action="Index">
                        <i class="ri-home-5-line"></i> <span>Início</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link menu-link @Ativo("Produtos")" asp-controller="Produtos" asp-action="Index">
                        <i class="ri-box-3-line"></i> <span>Produtos</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link menu-link @Ativo("Depositos")" asp-controller="Depositos" asp-action="Index">
                        <i class="ri-building-2-line"></i> <span>Depósitos</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link menu-link @Ativo("Estoque")" asp-controller="Estoque" asp-action="Index">
                        <i class="ri-stack-line"></i> <span>Estoque</span>
                    </a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="menu-title"><span>Administração</span></li>
                    <li class="nav-item">
                        <a class="nav-link menu-link @Ativo("Usuarios")" asp-controller="Usuarios" asp-action="Novo">
                            <i class="ri-user-add-line"></i> <span>Novo usuário</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="sidebar-background"></div>
</div>
<div class="vertical-overlay"></div>
