@model NovoProdutoViewModel
@{
    ViewData["Title"] = "Novo produto";
}

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <partial name="_Erros" />
                <form asp-action="Novo" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Sku" class="form-label"></label>
                        <input asp-for="Sku" class="form-control" maxlength="50" autofocus />
                        <span asp-validation-for="Sku" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" maxlength="200" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Unidade" class="form-label"></label>
                        <input asp-for="Unidade" class="form-control" maxlength="10" />
                        <span asp-validation-for="Unidade" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-success">Salvar</button>
                    <a asp-action="Index" class="btn btn-light">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
